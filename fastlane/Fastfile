default_platform(:ios)

APP_IDENTIFIER = "com.maxnguyen.caretap"
APP_VERSION = "1.0"
TEAM_ID = "R662BH835Y"
DEFAULT_KEY_ID = "H53X5AB675"
DEFAULT_KEY_FILEPATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_H53X5AB675.p8")
PROJECT_ROOT = File.expand_path("..", __dir__)
METADATA_PATH = File.join(PROJECT_ROOT, "fastlane", "metadata")
SCREENSHOTS_PATH = File.join(PROJECT_ROOT, "fastlane", "screenshots")
DEFAULT_IPA_PATH = File.join(PROJECT_ROOT, "build", "app-store", "TapCare.ipa")
REVIEW_NOTES_PATH = File.expand_path("metadata/review_information/notes.txt", __dir__)

platform :ios do
  desc "Build a Release IPA for App Store Connect. Does not upload or submit."
  lane :build_release do
    build_app(
      project: File.join(PROJECT_ROOT, "CareTap.xcodeproj"),
      scheme: "CareTap",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(PROJECT_ROOT, "build", "app-store"),
      output_name: "TapCare.ipa",
      clean: true,
      include_symbols: true,
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID} -allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Upload TapCare App Store metadata/screenshots only. Does not upload a binary or submit for review."
  lane :upload_metadata_only do
    upload_submission_package(skip_binary_upload: true)
  end

  desc "Upload an existing IPA only. Does not upload metadata/screenshots or submit for review."
  lane :upload_build_only do
    ipa_path = ENV.fetch("IPA_PATH", DEFAULT_IPA_PATH)
    UI.user_error!("IPA not found at #{ipa_path}. Run `fastlane ios build_release` first or set IPA_PATH.") unless File.exist?(ipa_path)

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and upload binary plus metadata/screenshots. Stops before App Review submission."
  lane :upload_everything_except_submit do
    ipa_path = build_release
    upload_submission_package(skip_binary_upload: false, ipa: ipa_path)
  end

  desc "Print the local TapCare submission package paths and current safety settings."
  lane :preview_submission_package do
    UI.message("Public App Store name: TapCare")
    UI.message("Bundle ID: #{APP_IDENTIFIER}")
    UI.message("Version: #{APP_VERSION}")
    UI.message("Metadata: #{File.join(METADATA_PATH, "en-US")}")
    UI.message("Review notes: #{REVIEW_NOTES_PATH}")
    UI.message("Screenshots: #{File.join(SCREENSHOTS_PATH, "en-US")}")
    UI.message("Submit for review: false")
    UI.message("TapCare Premium / IAP: not included")
    UI.important("Set TAPCARE_REVIEW_PHONE before any upload lane.") if ENV["TAPCARE_REVIEW_PHONE"].to_s.strip.empty?
    UI.important("No screenshots found yet.") unless screenshots_present
  end

  private_lane :upload_submission_package do |options|
    screenshots_ready = screenshots_present
    UI.important("No screenshots found in fastlane/screenshots/en-US. The upload will skip screenshots.") unless screenshots_ready

    deliver_options = {
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: options[:skip_binary_upload],
      skip_metadata: false,
      skip_screenshots: !screenshots_ready,
      overwrite_screenshots: screenshots_ready,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      price_tier: 0,
      primary_category: "Health & Fitness",
      secondary_category: "Medical",
      copyright: "2026 Maxwell Nguyen",
      app_review_information: app_review_information,
      submission_information: submission_information
    }

    deliver_options[:ipa] = options[:ipa] if options[:ipa]
    upload_to_app_store(deliver_options)
  end

  private_lane :asc_api_key do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID", DEFAULT_KEY_ID)
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_filepath = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH", DEFAULT_KEY_FILEPATH)

    UI.user_error!("App Store Connect API key not found at #{key_filepath}. Set APP_STORE_CONNECT_API_KEY_KEY_FILEPATH.") unless File.exist?(key_filepath)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id.to_s.strip.empty? ? nil : issuer_id,
      key_filepath: key_filepath,
      duration: 1200,
      in_house: false
    )
  end

  private_lane :app_review_information do
    phone = ENV["TAPCARE_REVIEW_PHONE"].to_s.strip
    UI.user_error!("Set TAPCARE_REVIEW_PHONE to a real reachable phone number before uploading.") if phone.empty?

    {
      first_name: ENV.fetch("TAPCARE_REVIEW_FIRST_NAME", "Maxwell"),
      last_name: ENV.fetch("TAPCARE_REVIEW_LAST_NAME", "Nguyen"),
      phone_number: phone,
      email_address: ENV.fetch("TAPCARE_REVIEW_EMAIL", "support@tapcare.app"),
      demo_user: "",
      demo_password: "",
      notes: File.read(REVIEW_NOTES_PATH)
    }
  end

  private_lane :submission_information do
    {
      add_id_info_uses_idfa: false,
      content_rights_contains_third_party_content: false,
      export_compliance_uses_encryption: false,
      export_compliance_is_exempt: true
    }
  end

  private_lane :screenshots_present do
    Dir.glob(File.join(SCREENSHOTS_PATH, "en-US", "**", "*.{png,jpg,jpeg}"), File::FNM_CASEFOLD).any?
  end
end
